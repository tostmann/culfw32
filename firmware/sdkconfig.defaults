# Complete project configuration: everything that differs from the ESP-IDF default.
# Generate it from the built configuration with `idf.py save-defconfig` and
# reconcile it with the explanations here; a build without firmware/sdkconfig must
# produce the same image.

# Target.
CONFIG_IDF_TARGET="esp32c6"

# 4 MB flash with a custom partition table (partitions.csv: two OTA slots).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# Frontends that can be switched off via Kconfig and are on in the shipped image.
CONFIG_CULFW32_BUILD_FRONTEND_JSON=y
CONFIG_CULFW32_BUILD_FRONTEND_HMUARTLGW=y
CONFIG_CULFW32_BUILD_FRONTEND_WEBUI=y

# Web UI terminal and live push run over WebSocket.
CONFIG_HTTPD_WS_SUPPORT=y

# C++: no exceptions / RTTI -> code size, IRQ-stack-friendly.
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# USB-Serial-JTAG as stdout (built into the ESP32-C6, no TinyUSB needed for the culfw tty).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Mainline logging at info level for now, tunable per module in the field via menuconfig.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Task watchdog enabled.
CONFIG_ESP_TASK_WDT_INIT=y

# FreeRTOS trace facility for uxTaskGetSystemState in `?stats` (stack high-water
# table). +~3 KB RAM, no significant code overhead. Used by the system_monitor
# component to report stack usage per task.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# Socket pool for parallel use: 5 TCP server listen sockets (ASCII 2323, JSON 2324,
# HMUARTLGW Legacy 2325, SignalDuino 2326, HMUARTLGW Dual 2327) + httpd
# (max_open_sockets=13) + accepted client sockets per listener + mDNS + reserve.
# 16 was too tight — JSON/HMU listeners intermittently lost their slot, connections
# ran into timeouts (verified 2026-05-01, build 0.1.157).
# 24 gives 5+13+6 headroom for several parallel browser sessions + smoke tests.
CONFIG_LWIP_MAX_SOCKETS=24

# Online update (components/ota_update): an image loaded via OTA starts as
# PENDING_VERIFY and is only confirmed after it has run stably; otherwise the
# bootloader boots the previous one. This lives in the BOOTLOADER — which only
# reaches the device via USB/web flasher, so it must already be on in the shipped image.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# TLS for the online update talks only to install.busware.de (Let's Encrypt;
# today the chain ends via the cross-signature by ISRG Root X1). X1/X2 are in the
# "common" bundle just as in the full one; the full one costs ~45 KB more.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y

# TLS buffers only on demand and only as large as the record (online update). With
# all network services running, the heap is tight and fragmented; fixed 16 KB + 4 KB
# per session failed on 8 October in mbedtls_ssl_setup (-0x7F00).
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y

# WiFi code in flash instead of IRAM. On the C6, IRAM and DRAM share one SRAM —
# every KB here is heap. Over WiFi, the TLS handshake of the online update needed
# more than the ~56 KB that are free with all network services running
# (8 October: alloc(4437) failed, heap minimum 1.5 KB). A CUL does not need the
# throughput these options buy. Power save is off (WIFI_PS_NONE), so the SLP
# path never runs.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
CONFIG_PM_SLEEP_FUNC_IN_IRAM=n
# Light-sleep code in IRAM: set this way in the shipped configuration.
CONFIG_PM_SLP_IRAM_OPT=y

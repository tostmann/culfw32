*.pyc
*.pyo

# Editor / OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Local backup/scratch
*.bak
*.orig

# Vendored FHEM distribution for HMUARTLGW tests — throwaway, available upstream.
# Only our own traces are meant to be committed; the FHEM reference lives upstream
# (https://svn.fhem.de/trac/browser/trunk/fhem/FHEM/00_HMUARTLGW.pm).
test/hmuartlgw/fhem-data/
test/hmuartlgw/HMUARTLGW.pm

# Tool working directories
.claude/

# Homegear test container data
test/homegear/

# Local trace/capture dumps (RF sniffer, USB-mon, DSLogic)
*.sr
*.pcap
*.pcapng
firmware/test/hmuartlgw/*.strace.log

# Local working notes, secrets, logs, third-party data sheets and schematics
# do not belong in the repository.
CLAUDE.md
MEMORY.md
GEMINI.md
FACTS.md
HARDWARE_STATUS.md
.env
.env.*
*.key
*.pem
*.log
schematics/
datasheets/
datasheet/


# Local measurement/session artifacts (stay local)
test/rmt_idle_2026-08-29/
test/pa_2026-09-03/
test/pa_2026-09-07/
test/protomatrix_2026-10-08/
test/hmu_acktime_2026-11-01/

# Product photos, stored locally — not part of the firmware sources
/pics/

# Released delivery artifacts: archived, but NOT versioned.
# ESP-IDF builds are not bit-reproducible without SOURCE_DATE_EPOCH, so released
# binaries have to be kept — but build outputs do not belong in version control.
# The MANIFEST per release is the exception: it records commit, md5 and approval.
releases/**
!releases/**/
!releases/**/MANIFEST.md

# Session artifacts
*.pid

# Build outputs do not belong in version control — this includes
# host test binaries under components/*/test/.
firmware/components/*/test/test_*
!firmware/components/*/test/test_*.c
!firmware/components/*/test/test_*.cpp
!firmware/components/*/test/test_*.h
!firmware/components/*/test/test_*.hpp

# Measurement and session artifacts of individual investigations. Ignore the
# directory as a whole and re-include with '!' when needed - the
# pre-build hook otherwise runs 'git add -A' and collects them again.
test/freq_2026-08-22/

# AVR build artifacts (avr/dudette2) — reproducible from the sources with `make`
avr/**/*.elf
avr/**/*.hex
avr/**/*.map

# Day plans/session artifacts with lab context stay local
notes/dudette_v2_plan_*.md

# Deploy targets — never into the repo
firmware/tools/deploy.conf
